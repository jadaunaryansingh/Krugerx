# ==========================================
# Root Gitignore for Krugerx Project
# ==========================================

# Active Environment & Secret Files (CRITICAL: Never commit these!)
.env
.env.*
*.env
*.env.*
**/.*env
**/.*env.*
*.key
*.pem
*.cert
secrets.json
credentials.json
*.p12

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest / Test / Coverage
.pytest_cache/
.tox/
.nosetests
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
*.cover

# Celery & Beat scheduler files
celerybeat-schedule
celerybeat.pid

# Docker volumes and files
.docker/
db_data/
redis_data/

# IDE / Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.DS_Store

# Logs
*.log
backend/Backend/logs/

# Frontend / Mobile specific (Flutter / Dart)
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/ios/.symlinks/
frontend/ios/Flutter/Flutter.framework
frontend/ios/Flutter/Flutter.podspec
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/flutter_export_environment.sh
frontend/android/key.properties
frontend/android/app/src/main/res/raw/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Scratch / Temporary directories
scratch/
scratch_*
*.scratch

