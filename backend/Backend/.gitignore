# ==========================================
# Backend Gitignore - Krishna Browser Backend
# ==========================================

# Active Environment & Secret Files (CRITICAL: Never commit these!)
.env
.env.*
*.env
*.env.*
*.key
*.pem
*.cert
secrets.json
credentials.json
*.p12

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest / Test / Coverage
.pytest_cache/
.tox/
.nosetests
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
*.cover

# Celery / Beat scheduler files
celerybeat-schedule
celerybeat.pid

# Docker volumes and files
.docker/
db_data/
redis_data/

# IDE / Editor configurations
.vscode/
.idea/
*.suo
*.swp
*.swo
.DS_Store
